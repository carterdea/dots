#!/usr/bin/env bash
set -uo pipefail

export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DOTS_DIR="${REPOS_SYNC_DOTS_DIR:-$(dirname "$(dirname "$SELF")")}"
ROOT="${REPOS_SYNC_ROOT:-$HOME/Sites}"

default_branch() {
    local ref branch
    if ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD)"; then
        echo "${ref#origin/}"
        return
    fi
    for branch in main master; do
        if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
            echo "$branch"
            return
        fi
    done
    return 1
}

sync_repo() {
    local branch
    git remote get-url origin >/dev/null 2>&1 || return 0
    git fetch --quiet --prune origin 2>/dev/null || { echo "fetch failed"; return 1; }
    branch="$(default_branch)" || return 0
    git show-ref --verify --quiet "refs/heads/$branch" || return 0
    [ "$(git rev-parse "$branch")" != "$(git rev-parse "origin/$branch")" ] || return 0

    if ! git merge-base --is-ancestor "$branch" "origin/$branch"; then
        echo "skipped: local $branch has commits not on origin"
    elif [ "$(git symbolic-ref --quiet --short HEAD)" = "$branch" ]; then
        if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
            echo "skipped: uncommitted changes on $branch"
        elif git merge --quiet --ff-only "origin/$branch" >/dev/null 2>&1; then
            echo "updated $branch"
        else
            echo "skipped: fast-forward of $branch would overwrite untracked files"
        fi
    elif git fetch --quiet . "origin/$branch:$branch" 2>/dev/null; then
        echo "updated $branch"
    else
        echo "skipped: $branch is checked out in another worktree"
    fi
}

if [ "${1:-}" = "--repo" ]; then
    [ $# -eq 2 ] || exit 0
    message="$(cd "$2" && sync_repo)"
    status=$?
    [ -z "$message" ] || echo "$(basename "$2"): $message"
    exit "$status"
fi

dots_before="$(git -C "$DOTS_DIR" rev-parse HEAD 2>/dev/null)"
status=0
for git_dir in "$ROOT"/*/.git; do
    [ -d "$git_dir" ] && printf '%s\0' "${git_dir%/.git}"
done | xargs -0 -n1 -P8 "$SELF" --repo || status=1

if [ "$(git -C "$DOTS_DIR" rev-parse HEAD 2>/dev/null)" != "$dots_before" ]; then
    echo "dots changed; running install.sh ${REPOS_SYNC_INSTALL_ARGS:---all}"
    # shellcheck disable=SC2086
    REPOS_SYNC_RUNNING=1 "$DOTS_DIR/install.sh" ${REPOS_SYNC_INSTALL_ARGS:---all} || status=1
fi

exit "$status"
