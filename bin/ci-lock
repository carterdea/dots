#!/usr/bin/env bash
# Parse the whole program before running it: this file is symlinked into
# PATH and may be rewritten while an invocation waits for the lock.
{
# Machine-wide semaphore for CI-style checks.
# Usage: [CI_LOCK_LANE=<lane>] [CI_LOCK_SLOTS=<n>] ci-lock <command> [args...]
# Commands queue per lane across every project, no matter how many agents
# commit/push at once. Fast and check lanes run one at a time; heavy runs two,
# never two from the same repository. Lanes are independent — the default "heavy" lane (tests, e2e,
# builds) never blocks the "fast" lane (staged lint/format on commit), so a
# commit only ever waits behind other commits, not behind a test suite.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: [CI_LOCK_LANE=<lane>] ci-lock <command> [args...]" >&2
  exit 64
fi

LANE="${CI_LOCK_LANE:-heavy}"
if ! [[ "$LANE" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  echo "ci-lock: invalid lane '$LANE' (want [a-z0-9_-])" >&2
  exit 64
fi

# Kept under $HOME rather than /tmp: a world-writable lock path can be
# pre-created as a symlink, and opening it for write follows and truncates
# whatever it points at.
LOCK_FILE="${CI_LOCK_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/ci-lock/$LANE.lock}"
# A fast-lane check waiting anywhere near the heavy timeout means the queue
# is wedged, not busy; give it a much shorter leash. The check lane
# (typecheck/lint) sits in between: minutes of work, never half an hour.
if [[ "$LANE" == "heavy" ]]; then
  LOCK_TIMEOUT="${CI_LOCK_TIMEOUT:-1800}"
elif [[ "$LANE" == "check" ]]; then
  LOCK_TIMEOUT="${CI_LOCK_TIMEOUT:-600}"
else
  LOCK_TIMEOUT="${CI_LOCK_TIMEOUT:-300}"
fi

# The shared heavy lane runs two checks at once: one machine has the cores for
# it, and a single slot left suites waiting hours on busy days. A private lock
# file (CI_LOCK_FILE) stays a plain mutex unless it asks for more.
SHARED_LANE=0
[[ "$LANE" != "heavy" || -n "${CI_LOCK_FILE:-}" ]] || SHARED_LANE=1
if ((SHARED_LANE)); then
  SLOTS="${CI_LOCK_SLOTS:-2}"
else
  SLOTS="${CI_LOCK_SLOTS:-1}"
fi
if ! [[ "$SLOTS" =~ ^[1-9][0-9]{0,2}$ ]]; then
  echo "ci-lock: invalid slot count '$SLOTS' (want 1-999)" >&2
  exit 64
fi

# Every caller of the shared heavy lane takes it, whatever its slot count, so
# a single-slot caller in slot 0 still excludes its repository from slot 1.
REPO_LOCK=""
REPO_KEY=""
# Redirections that close the lock descriptors this run opened (see launch).
LOCK_FDS=""
if ((SLOTS > 1 || SHARED_LANE)); then
  # Keyed on the directory ci-lock starts in: a pre-push hook runs at its
  # repository's root and an agent session runs in its worktree. Inherited
  # GIT_* variables would name the caller's repository instead, so they are
  # dropped for this lookup only.
  repo_dir="$(env -u GIT_DIR -u GIT_COMMON_DIR -u GIT_WORK_TREE -u GIT_CEILING_DIRECTORIES \
    git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || repo_dir=""
  if [[ -n "$repo_dir" ]]; then
    # Hex only, so it can sit in the held marker beside its delimiters.
    REPO_KEY="$(printf '%s' "$repo_dir" | shasum | cut -c1-12)"
    REPO_LOCK="$LOCK_FILE.repo-$REPO_KEY"
  fi
fi

# A wrapped command may reach ci-lock again — a pre-push hook is already
# queued, and a check inside it is written as `ci-lock <suite>`. Waiting
# would mean waiting on a lock this very process tree holds, so reuse it.
# The marker is per-lane (one env var per lane) so holding the fast lock
# never masks an ancestor's heavy hold, and vice versa. The holder's pid is
# part of the marker because a background descendant can outlive the holder
# and keep the variable in its environment; reusing the lock then would mean
# not holding one at all.
HELD_VAR="CI_LOCK_HELD_$(printf '%s' "${LANE//-/_}" | tr '[:lower:]' '[:upper:]')"
# The marker is "<lock file>:<repo key>:<holder pid>"; the key is hex (or
# empty outside a repository), so no path character can collide with the
# delimiters. Re-entering from the same repository, or from outside any,
# reuses the held slot and lock. Re-entering from a different repository is
# refused: running there needs that repository's lock, and waiting for it
# while holding a slot others need could deadlock.
if [[ "${!HELD_VAR:-}" == "$LOCK_FILE:"* ]]; then
  held="${!HELD_VAR#"$LOCK_FILE:"}"
  holder="${held##*:}"
  if kill -0 "$holder" 2>/dev/null; then
    if [[ -z "$REPO_KEY" || "${held%:*}" == "$REPO_KEY" ]]; then
      exec "$@"
    fi
    echo "ci-lock: already holding a $LANE slot for another repository; run this check on its own" >&2
    exit 1
  fi
fi

# The queue is an optimization, not a gate: without flock the checks still
# run, just unserialized. Failing the push over a missing tool is worse.
if ! command -v flock >/dev/null 2>&1; then
  echo "ci-lock: flock not found (brew install flock); running without the queue" >&2
  exec "$@"
fi

mkdir -p "$(dirname "$LOCK_FILE")"

CI_LOCK_LOG="${CI_LOCK_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/ci-lock/ci-lock.log}"
if ! [[ "$LOCK_TIMEOUT" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]; then
  echo "ci-lock: invalid timeout '$LOCK_TIMEOUT' (want nonnegative seconds)" >&2
  exit 64
fi
# macOS date and Bash 3.2 lack subsecond clocks; system Perl supplies one.
now_ms() { perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC -e 'printf "%.0f", clock_gettime(CLOCK_MONOTONIC) * 1000'; }
boot_id="$(sysctl -n kern.bootsessionuuid 2>/dev/null || cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)"
if ! queued_ms="$(now_ms 2>/dev/null)" ||
  ! timeout_ms="$(perl -e 'printf "%.0f", $ARGV[0] * 1000' "$LOCK_TIMEOUT" 2>/dev/null)"; then
  echo "ci-lock: monotonic clock unavailable; running without the queue" >&2
  exec "$@"
fi
deadline=$((queued_ms + timeout_ms))
owner_start="$(LC_ALL=C ps -o lstart= -p "$$" 2>/dev/null)" || owner_start=""

# Tabs and newlines in the command would add fields or records to the
# tab-separated log; flatten them so one run is always one six-field line.
cmd_str="$*"
cmd_str="${cmd_str//$'\t'/ }"
cmd_str="${cmd_str//$'\n'/ }"

# One line per run — when, lane, seconds queued, seconds running, exit code,
# command — the duration data queue tuning never had. A wait that times out
# logs too, with `timeout` in the exit field, so the waits that never got to
# run are as visible as the ones that did.
log_run() {
  mkdir -p "$(dirname "$CI_LOCK_LOG")" 2>/dev/null || true
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$LANE" \
    "$1" "$2" "$3" "${cmd_str:0:200}" >>"$CI_LOCK_LOG" 2>/dev/null || true
}

# FIFO queue. macOS flock wakes every waiter on unlock and they race, so
# acquisition order is arbitrary: waiters have starved for the whole timeout
# while newer arrivals slipped past them. Tickets impose arrival order, while
# flock on $LOCK_FILE stays the actual mutex — an older ci-lock that knows
# nothing about tickets is still mutually excluded with a new one.
QUEUE_DIR="$LOCK_FILE.q"
# Old epoch-named tickets sort before new monotonic tickets during upgrades.
# Millisecond ties use the PID; wall-clock corrections cannot reorder arrivals.
TICKET="$(printf '%s/m%015d-%010d' "$QUEUE_DIR" "$queued_ms" "$$")"
# Names the repository a waiting ticket belongs to (see may_contend). A dotfile,
# so ticket scans never mistake it for a ticket.
REPO_NOTE="$QUEUE_DIR/.repo-${TICKET##*/}"
mkdir -m 700 "$QUEUE_DIR" 2>/dev/null || true
if ! perl -MFcntl=:mode -e 'my @s = lstat $ARGV[0];
    exit(!@s || !S_ISDIR($s[2]) || $s[4] != $< || ($s[2] & 0022));' "$QUEUE_DIR"; then
  echo "ci-lock: unsafe queue directory: $QUEUE_DIR" >&2
  exit 73
fi

# True when a ticket's owner is still waiting; otherwise drops the ticket, so
# a killed waiter cannot wedge the queue. Each ticket carries its own expiry,
# so callers with shorter timeouts cannot evict a live waiter with a longer
# budget. Legacy empty tickets are removed only when their owner is gone.
ticket_live() {
  local ticket="$1" expiry clock ticket_boot pid process_state ticket_start actual_start
  expiry="$(cat "$ticket" 2>/dev/null)" || return 1
  ticket_start=""
  if [[ "$expiry" == *'|'* ]]; then
    ticket_start="${expiry#*|}"
    expiry="${expiry%%|*}"
  fi
  clock="$(now_ms)"
  if [[ "$expiry" == *:* ]]; then
    ticket_boot="${expiry%%:*}"
    expiry="${expiry#*:}"
    if [[ "$boot_id" != unknown && "$ticket_boot" != unknown && "$ticket_boot" != "$boot_id" ]]; then
      rm -f "$ticket" "$QUEUE_DIR/.repo-${ticket##*/}"
      return 1
    fi
  else
    # Numeric tickets from older versions use epoch milliseconds.
    clock=$(($(date +%s) * 1000))
  fi
  # 10# because the fields are zero-padded, and a leading zero reads as octal.
  pid="$((10#${ticket##*-}))"
  process_state="$(ps -o stat= -p "$pid" 2>/dev/null)" || process_state=""
  if [[ -n "$ticket_start" ]]; then
    actual_start="$(LC_ALL=C ps -o lstart= -p "$pid" 2>/dev/null)" || actual_start=""
    if [[ -n "$actual_start" && "$actual_start" != "$ticket_start" ]]; then
      rm -f "$ticket" "$QUEUE_DIR/.repo-${ticket##*/}"
      return 1
    fi
  fi
  if kill -0 "$pid" 2>/dev/null && [[ ! "$process_state" =~ Z ]] &&
    { [[ "$ticket" == "$TICKET" || ! "$expiry" =~ ^[0-9]+$ ]] || ((clock <= expiry)); }; then
    return 0
  fi
  rm -f "$ticket" "$QUEUE_DIR/.repo-${ticket##*/}"
  return 1
}

# True when a repository lock is held by a running check.
repo_lock_held() {
  [[ "$1" == "$LOCK_FILE.repo-"* && ! -L "$1" ]] || return 1
  ( exec 197>"$1" && ! flock -n 197 )
}

# True when this waiter may contend for a slot now. Normally only the oldest
# live ticket may, so arrival order decides who goes next. The exception: an
# older waiter whose repository already has a check running cannot start
# anyway, so a waiter from another repository may take a free slot past it
# instead of leaving that slot idle. The scan stops at the first live ticket
# that still has a claim.
may_contend() {
  local ticket repo_lock
  for ticket in "$QUEUE_DIR"/*; do
    [[ -f "$ticket" && ! -L "$ticket" && "${ticket##*/}" =~ ^m?[0-9]+-[0-9]+$ ]] || continue
    [[ "$ticket" == "$TICKET" ]] && return 0
    ticket_live "$ticket" || continue
    ((SLOTS > 1)) || return 1
    repo_lock="$(cat "$QUEUE_DIR/.repo-${ticket##*/}" 2>/dev/null)" || return 1
    # The same repository as ours means we are blocked too; keep the order.
    [[ -n "$repo_lock" && "$repo_lock" != "$REPO_LOCK" ]] || return 1
    repo_lock_held "$repo_lock" || return 1
  done
  return 1
}

# Slot 0 is the lane's own lock file, so an older ci-lock that knows nothing
# about slots still excludes, and is excluded by, one slot.
slot_file() {
  if (($1 == 0)); then printf '%s' "$LOCK_FILE"; else printf '%s.%d' "$LOCK_FILE" "$1"; fi
}

# Two slots must not go to the same repository: worktrees of one project share
# fixed ports and test databases, and running two of its suites at once trades
# queue time for flakes. fd 198 holds a per-repo lock beside the slot on fd 199.

# A slot-0 holder from this version also holds the owner lock (fd 196). Slot 0
# held without it means an older ci-lock is running, one that took no
# repository lock, so a second slot could run its repository twice.
OWNER_LOCK="$LOCK_FILE.owner"
slot0_owned() {
  ( exec 197>"$OWNER_LOCK" && ! flock -n 197 )
}
slot0_held() {
  ( exec 197>"$LOCK_FILE" && ! flock -n 197 )
}

# Takes the repo lock (if any) and then any free slot, all nonblocking. On
# failure nothing stays held, so the queue head never sits on half a claim.
try_slots() {
  local slot
  if [[ -n "$REPO_LOCK" ]]; then
    exec 198>"$REPO_LOCK"
    flock -n 198 || { exec 198>&-; return 1; }
  fi
  for ((slot = 0; slot < SLOTS; slot++)); do
    ((slot == 0)) || slot0_owned || break
    # Closed first: bash 3.2 silently keeps an open fd above 9 on reopen.
    exec 199>&-
    exec 199>"$(slot_file "$slot")"
    if flock -n 199; then
      # Re-check once the slot is ours: slot 0 may have changed hands to an
      # older ci-lock between the check above and this claim.
      if ((slot > 0)) && slot0_held && ! slot0_owned; then
        break
      fi
      LOCK_FDS="199>&-"
      [[ -z "$REPO_LOCK" ]] || LOCK_FDS+=" 198>&-"
      if ((slot == 0 && (SLOTS > 1 || SHARED_LANE))); then
        exec 196>"$OWNER_LOCK"
        flock -n 196 || true
        LOCK_FDS+=" 196>&-"
      fi
      return 0
    fi
  done
  exec 199>&-
  [[ -z "$REPO_LOCK" ]] || exec 198>&-
  return 1
}

# Only the head of the queue contends for flock; everyone else polls. That
# way arrival order decides who goes next, not the kernel's wakeup race.
acquire() {
  local remaining interval wait_seconds
  # Publish a complete ticket before contending, including on a free lock.
  # The owner's initial nonblocking attempt is allowed even with zero timeout.
  # Published before the ticket, so no waiter ever sees a ticket whose
  # repository is unknown and mistakes it for one that cannot be passed.
  [[ -z "$REPO_LOCK" ]] || printf '%s\n' "$REPO_LOCK" >"$REPO_NOTE"
  printf '%s:%s|%s\n' "$boot_id" "$deadline" "$owner_start" >"$QUEUE_DIR/.$$"
  mv "$QUEUE_DIR/.$$" "$TICKET"
  if may_contend && try_slots; then
    return 0
  fi
  echo "ci-lock: another $LANE check is running; waiting in queue (max ${LOCK_TIMEOUT}s)..." >&2
  while :; do
    remaining=$((deadline - $(now_ms)))
    ((remaining > 0)) || return 1
    interval=$remaining
    ((interval <= 1000)) || interval=1000
    printf -v wait_seconds '%d.%03d' "$((interval / 1000))" "$((interval % 1000))"
    if may_contend; then
      # One second at a time rather than one blocking wait for the whole
      # budget: bash runs a trap only once the foreground command returns,
      # and a waiter that ignores Ctrl-C for half an hour — leaving its
      # ticket behind the whole time — is its own kind of wedge.
      if ((SLOTS == 1)) && [[ -z "$REPO_LOCK" ]]; then
        exec 199>&-
        exec 199>"$LOCK_FILE"
        LOCK_FDS="199>&-"
        flock -w "$wait_seconds" 199 && return 0
      else
        # No single descriptor to block on across slots, or a repository
        # lock to take alongside the slot; poll them briefly.
        try_slots && return 0
        ((interval <= 250)) || wait_seconds=0.250
        sleep "$wait_seconds"
      fi
    else
      sleep "$wait_seconds"
    fi
  done
}

# This script holds the lock on fd 199 (and the repo lock on fd 198) for as long
# as the command runs, so acquiring it stays separate from running it and no
# exit code has to do double duty as "could not get the lock".

# The ticket has to go even if the wait is cut short. The signal traps exit
# rather than clean up directly so there is one removal path; they are
# replaced with child-forwarding traps once the command is running.
trap 'rm -f "$TICKET" "$REPO_NOTE" "$QUEUE_DIR/.$$"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

if ! acquire; then
  echo "ci-lock: timed out after ${LOCK_TIMEOUT}s waiting for $LOCK_FILE" >&2
  log_run "$((($(now_ms) - queued_ms) / 1000))" 0 timeout
  exit 1
fi
# The queue holds waiters only: leaving the ticket in place would make the
# next arrival think it is not head and never block on flock.
rm -f "$TICKET" "$REPO_NOTE"

export "$HELD_VAR=$LOCK_FILE:$REPO_KEY:$$"
started_ms="$(now_ms)"

# LOCK_FDS closes the lock descriptors for the command and everything it spawns.
# Without it, a check that leaves a background process behind (a test server,
# a container) hands that process the lock, and it keeps holding it long
# after the check itself has exited.
#
# Run it as a job and wait, rather than in the foreground, so a supervisor
# that signals only this wrapper cannot leave the command running with the
# lock already released. <&0 keeps stdin attached, which a backgrounded job
# would otherwise lose — pre-push hooks read their refs from it.
child=""
pending_signal=""
forward_signal() {
  if [[ -n "$child" ]]; then
    kill -"$1" "$child" 2>/dev/null || true
  else
    pending_signal="$1"
  fi
}
trap 'forward_signal TERM' TERM
trap 'forward_signal HUP' HUP
# Ctrl-C is forwarded as TERM, not INT: POSIX has the shell set SIGINT to
# ignore in an asynchronous job, and an ignored disposition survives exec, so
# the command cannot be interrupted by the signal it was sent. Without this a
# cancelled push keeps running its suite and keeps the queue behind it.
trap 'forward_signal TERM' INT

# Only the descriptors this run opened are closed. They are high numbers
# (196-199) so a caller's own low descriptors (8<input, say) pass through.
eval "\"\$@\" $LOCK_FDS <&0 &"
child=$!
[[ -z "$pending_signal" ]] || forward_signal "$pending_signal"

set +e
wait "$child"
status=$?
# A trapped signal makes wait return >128 while the child is still shutting
# down; keep waiting so the lock outlives it.
while ((status > 128)) && kill -0 "$child" 2>/dev/null; do
  wait "$child"
  status=$?
done
set -e

log_run "$(((started_ms - queued_ms) / 1000))" "$((($(now_ms) - started_ms) / 1000))" "$status"

exit "$status"
}
