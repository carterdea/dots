#!/usr/bin/env bash
# Machine-wide semaphore for heavy checks (tests, e2e, builds).
# Usage: ci-lock <command> [args...]
# All ci-lock'd commands across every project share one lock, so only one
# heavy suite runs at a time no matter how many agents commit/push at once.
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: ci-lock <command> [args...]" >&2
  exit 64
fi

# Kept under $HOME rather than /tmp: a world-writable lock path can be
# pre-created as a symlink, and opening it for write follows and truncates
# whatever it points at.
LOCK_FILE="${CI_LOCK_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/ci-lock/heavy.lock}"
LOCK_TIMEOUT="${CI_LOCK_TIMEOUT:-1800}"
LOCK_BUSY=75

# The queue is an optimization, not a gate: without flock the checks still
# run, just unserialized. Failing the push over a missing tool is worse.
if ! command -v flock >/dev/null 2>&1; then
  echo "ci-lock: flock not found (brew install flock); running without the queue" >&2
  exec "$@"
fi

mkdir -p "$(dirname "$LOCK_FILE")"

# Probe only so a queued run can say so; the lock itself is taken below.
if ! flock -n "$LOCK_FILE" true 2>/dev/null; then
  echo "ci-lock: another heavy check is running; waiting in queue (max ${LOCK_TIMEOUT}s)..." >&2
fi

# --close: a check that leaves a background process behind (a test server, a
# container) would otherwise pass the lock descriptor to it, and that child
# keeps the lock long after the check itself has exited.
# -E: distinguishes "never got the lock" from the command's own exit code.
set +e
flock --close --conflict-exit-code "$LOCK_BUSY" --timeout "$LOCK_TIMEOUT" \
  "$LOCK_FILE" "$@"
status=$?
set -e

if [[ $status -eq "$LOCK_BUSY" ]]; then
  echo "ci-lock: timed out after ${LOCK_TIMEOUT}s waiting for $LOCK_FILE" >&2
  exit 1
fi
exit "$status"
