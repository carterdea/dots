#!/usr/bin/env bash
# PreToolUse(Bash) hook: route long-running checks through ci-lock.
# Works under both Claude Code (~/.claude/settings.json) and Codex
# (~/.codex/hooks.json); both send {tool_input:{command}} on stdin.
#
# Quick checks stay instant. Full suites queue, so several agents cannot run
# heavy work at once. Pushes are already covered by the LEFTHOOK_BIN shim; this
# covers the far more common case of an agent running the suite directly.
#
# Modes:
#   dry-run (default) — decide, log to $CI_QUEUE_HOOK_LOG, change nothing
#   enforce           — CI_QUEUE_HOOK_ENFORCE=1, rewrite the command
#
# Always exits 0. A hook on every Bash call must never be the reason one fails.
set -uo pipefail

LOG="${CI_QUEUE_HOOK_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/ci-lock/queue-hook.log}"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

payload="$(cat 2>/dev/null || true)"

# Prefer jq; fall back to a crude extraction so a missing jq cannot break Bash.
if command -v jq >/dev/null 2>&1; then
  cmd="$(printf '%s' "$payload" | jq -r '.tool_input.command // .command // empty' 2>/dev/null)"
else
  cmd="$(printf '%s' "$payload" | sed -n 's/.*"command"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/p' | head -1)"
fi

[[ -z "${cmd:-}" ]] && exit 0

# A command that names a concrete source file is a scoped, quick check no
# matter which runner executes it. A token scan instead of one regex: paths
# are routinely kebab-case and quoted, and a file that is the value of a
# flag (vitest run --config vitest.e2e.ts) configures a full run rather
# than scoping it — only a file in argument position counts.
file_scoped() {
  local prev="" w t
  set -f
  # shellcheck disable=SC2086
  set -- $1
  set +f
  for w in "$@"; do
    t="${w#[\"\']}"
    t="${t%[\"\']}"
    if [[ "$t" =~ ^[^-][^[:space:]]*\.(ts|tsx|js|jsx|py|rb|go)$ ]] &&
      { [[ "$prev" == "--" ]] || [[ "$prev" != -* ]]; }; then
      return 0
    fi
    prev="$t"
  done
  return 1
}

# Everything between a heredoc operator and its terminator is data being
# written, not a command being run; classification must not see it, or a
# script whose text mentions a suite queues the cat that writes it.
strip_heredocs() {
  awk '
    body {
      line = $0
      sub(/^\t+/, "", line)
      if (line == tag) body = 0
      next
    }
    {
      print
      if (match($0, /<<-?[[:space:]]*[^<[:space:]]+/)) {
        tag = substr($0, RSTART, RLENGTH)
        sub(/^<<-?[[:space:]]*/, "", tag)
        gsub(/[^A-Za-z0-9_]/, "", tag)
        if (tag != "") body = 1
      }
    }
  '
}

# True when every segment of the command starts with a tool that only reads
# or reports. Their arguments routinely name suites — a grep FOR "pytest",
# a PR title mentioning playwright — and must not queue. Any segment led by
# something else falls through to normal classification.
read_only_cmd() {
  local seg first i
  local -a tok
  while IFS= read -r seg; do
    read -ra tok <<<"$seg"
    i=0
    while ((i < ${#tok[@]})) && [[ "${tok[i]}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do
      i=$((i + 1))
    done
    ((i >= ${#tok[@]})) && continue
    first="${tok[i]##*/}"
    case "$first" in
      sed|awk|grep|rg|cat|head|tail|ls|wc|sort|uniq|jq|find|echo|printf|cd|pwd|gh) ;;
      git)
        case "${tok[i + 1]:-}" in
          log|diff|show|status|branch|remote|ls-remote|ls-files|rev-parse|fetch|blame|describe) ;;
          *) return 1 ;;
        esac ;;
      *) return 1 ;;
    esac
  done < <(printf '%s\n' "$1" | tr '|;&' '\n')
  return 0
}

decide() {
  local cmd="$1"

  # 1. Never queue anything that does not exit on its own. A watch or server
  #    holding the machine-wide lock would block every project until timeout.
  if [[ "$cmd" =~ (--watch|[[:space:]]-w([[:space:]]|$)|--ui|interactive) ]] ||
    [[ "$cmd" =~ (run[[:space:]]+(dev|start|serve)|dev:|expo[[:space:]]+start|vite([[:space:]]|$)|next[[:space:]]+dev) ]]; then
    echo "SKIP watch-or-server"; return
  fi

  # 2. Already queued, or is the queue itself.
  if [[ "$cmd" =~ (ci-lock|lefthook) ]]; then echo "SKIP already-queued"; return; fi

  # 2.5. Every segment starts with a read-only tool — nothing heavy can run.
  if read_only_cmd "$cmd"; then echo "SKIP read-only-tool"; return; fi

  # 3. Scoped to specific files or a name filter — that is a quick check.
  if [[ "$cmd" =~ (-k[[:space:]]|-t[[:space:]]|--testNamePattern|--grep) ]]; then
    echo "SKIP name-filtered"; return
  fi
  if file_scoped "$cmd"; then
    echo "SKIP file-scoped"; return
  fi

  # 4. Long: full suites, e2e, project-wide typecheck, aggregates, builds.
  if [[ "$cmd" =~ (run[[:space:]]+test|bun[[:space:]]+test|vitest[[:space:]]+run|(^|[[:space:]])jest([[:space:]]|$)) ]] ||
    [[ "$cmd" =~ run[[:space:]]+--filter[[:space:]]+[^[:space:]]+[[:space:]]+test([[:space:]]|$) ]] ||
    [[ "$cmd" =~ ((^|[[:space:]])pytest([[:space:]]|$)|(^|[[:space:]])rspec([[:space:]]|$)|go[[:space:]]+test) ]] ||
    [[ "$cmd" =~ (playwright|cypress|detox) ]] ||
    [[ "$cmd" =~ (run[[:space:]]+typecheck|tsc[[:space:]]+--noEmit|basedpyright) ]] ||
    [[ "$cmd" =~ (verify[:-](quick|full|silent)|run[[:space:]]+check([[:space:]]|$)|run[[:space:]]+build) ]] ||
    [[ "$cmd" =~ scripts/(verify|test)[^[:space:]]*\.sh ]]; then
    echo "QUEUE long-check"; return
  fi

  echo "SKIP not-heavy"
}

verdict="$(decide "$(strip_heredocs <<<"$cmd")")"
action="${verdict%% *}"
reason="${verdict#* }"

printf '%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$action" "$reason" "${cmd:0:200}" >>"$LOG" 2>/dev/null || true

# Dry-run: observe only.
[[ "${CI_QUEUE_HOOK_ENFORCE:-0}" != "1" ]] && exit 0
[[ "$action" != "QUEUE" ]] && exit 0

lock="$HOME/.local/bin/ci-lock"
[[ -x "$lock" ]] || exit 0

command -v jq >/dev/null 2>&1 || exit 0

# Wrap through `bash -c` so a compound command (cd x && suite, pipes) runs
# entirely inside the lock. Prefixing `ci-lock` alone would bind only the
# first simple command, and the suite after `&&` would run unlocked.
wrapped="$lock bash -c $(printf '%s' "$cmd" | jq -Rrs '@sh')"

# Codex accepts updatedInput only alongside permissionDecision:"allow".
# Claude Code gets updatedInput without a decision so the rewritten command
# still goes through its normal permission flow. Codex payloads are the
# ones carrying a turn_id.
if printf '%s' "$payload" | jq -e 'has("turn_id")' >/dev/null 2>&1; then
  jq -cn --arg c "$wrapped" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"allow",updatedInput:{command:$c}}}' 2>/dev/null || true
else
  jq -cn --arg c "$wrapped" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",updatedInput:{command:$c}}}' 2>/dev/null || true
fi
exit 0
