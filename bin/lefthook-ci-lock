#!/usr/bin/env bash
# LEFTHOOK_BIN shim: routes `lefthook run pre-push` through ci-lock so heavy
# checks are serialized machine-wide with no per-repo config. Every other
# lefthook invocation (fast pre-commit checks) passes through unlocked.
# Exported from shell/.zshenv and shell/.bashrc; lefthook's generated
# .git/hooks scripts honor LEFTHOOK_BIN before any other resolution.
set -euo pipefail

LEFTHOOK_CMD=()

# LEFTHOOK_BIN short-circuits lefthook's own resolution chain, so this has to
# cover the same ground: project-local installs first, then the project's
# package manager, then a global binary.
resolve_lefthook() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

  if [[ -n "$root" ]]; then
    if [[ -x "$root/node_modules/.bin/lefthook" ]]; then
      LEFTHOOK_CMD=("$root/node_modules/.bin/lefthook")
      return
    fi
    # Yarn PnP has no node_modules to look in. Only claim it if yarn can
    # actually resolve lefthook, since a PnP repo may rely on a global one.
    if [[ -f "$root/.pnp.cjs" || -f "$root/.pnp.loader.mjs" ]] &&
      yarn bin lefthook >/dev/null 2>&1; then
      LEFTHOOK_CMD=(yarn lefthook)
      return
    fi
    if [[ -x "$root/.venv/bin/lefthook" ]]; then
      LEFTHOOK_CMD=("$root/.venv/bin/lefthook")
      return
    fi
    # An actual gem declaration, not any mention: a Gemfile commenting that
    # lefthook is installed globally would otherwise send the repo to bundler.
    if [[ -f "$root/Gemfile" ]] &&
      grep -qE '^[[:space:]]*gem[[:space:]]+["'\'']lefthook["'\'']' "$root/Gemfile"; then
      LEFTHOOK_CMD=(bundle exec lefthook)
      return
    fi
    # Python tools live in a project environment rather than on PATH, and the
    # runners are not interchangeable: `uv run` builds its own environment and
    # would miss a Poetry install entirely. Pick by lockfile.
    if [[ -f "$root/pyproject.toml" ]] &&
      grep -v '^[[:space:]]*#' "$root/pyproject.toml" | grep -q lefthook; then
      if [[ -f "$root/poetry.lock" ]]; then
        LEFTHOOK_CMD=(poetry run lefthook)
        return
      fi
      if [[ -f "$root/uv.lock" ]]; then
        LEFTHOOK_CMD=(uv run lefthook)
        return
      fi
    fi
  fi

  if command -v lefthook >/dev/null 2>&1; then
    LEFTHOOK_CMD=(lefthook)
    return
  fi
  if command -v mise >/dev/null 2>&1 && mise which lefthook >/dev/null 2>&1; then
    LEFTHOOK_CMD=(mise exec -- lefthook)
    return
  fi

  echo "lefthook-ci-lock: no lefthook binary found" >&2
  exit 1
}

# ci-lock is symlinked alongside this script; fall back to PATH.
find_ci_lock() {
  local here
  here="$(dirname "$0")"
  if [[ -x "$here/ci-lock" ]]; then
    echo "$here/ci-lock"
  else
    command -v ci-lock || true
  fi
}

resolve_lefthook

if [[ "${1:-}" == "run" && "${2:-}" == "pre-push" ]]; then
  lock="$(find_ci_lock)"
  if [[ -n "$lock" ]]; then
    exec "$lock" "${LEFTHOOK_CMD[@]}" "$@"
  fi
  echo "lefthook-ci-lock: ci-lock not found; running unqueued" >&2
fi

exec "${LEFTHOOK_CMD[@]}" "$@"
