#!/usr/bin/env bash
# LEFTHOOK_BIN shim: routes `lefthook run pre-push` through ci-lock so heavy
# checks are serialized machine-wide with no per-repo config. Every other
# lefthook invocation (fast pre-commit checks) passes through unlocked.
# Exported from shell/.zshenv and shell/.bashrc; lefthook's generated
# .git/hooks scripts honor LEFTHOOK_BIN before any other resolution.
set -euo pipefail

LEFTHOOK_CMD=()

# LEFTHOOK_BIN short-circuits lefthook's own resolution chain, so this has to
# cover the same ground: project-local installs first, then the project's
# package manager, then a global binary.
resolve_lefthook() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

  if [[ -n "$root" && -x "$root/node_modules/.bin/lefthook" ]]; then
    LEFTHOOK_CMD=("$root/node_modules/.bin/lefthook")
  elif [[ -n "$root" && -x "$root/.venv/bin/lefthook" ]]; then
    LEFTHOOK_CMD=("$root/.venv/bin/lefthook")
  elif [[ -n "$root" && -f "$root/Gemfile" ]] && grep -q lefthook "$root/Gemfile"; then
    LEFTHOOK_CMD=(bundle exec lefthook)
  elif [[ -n "$root" && -f "$root/pyproject.toml" ]] && grep -q lefthook "$root/pyproject.toml"; then
    LEFTHOOK_CMD=(uv run lefthook)
  elif command -v lefthook >/dev/null 2>&1; then
    LEFTHOOK_CMD=(lefthook)
  elif command -v mise >/dev/null 2>&1 && mise which lefthook >/dev/null 2>&1; then
    LEFTHOOK_CMD=(mise exec -- lefthook)
  else
    echo "lefthook-ci-lock: no lefthook binary found" >&2
    exit 1
  fi
}

# ci-lock is symlinked alongside this script; fall back to PATH.
find_ci_lock() {
  local here
  here="$(dirname "$0")"
  if [[ -x "$here/ci-lock" ]]; then
    echo "$here/ci-lock"
  else
    command -v ci-lock || true
  fi
}

resolve_lefthook

if [[ "${1:-}" == "run" && "${2:-}" == "pre-push" ]]; then
  lock="$(find_ci_lock)"
  if [[ -n "$lock" ]]; then
    exec "$lock" "${LEFTHOOK_CMD[@]}" "$@"
  fi
  echo "lefthook-ci-lock: ci-lock not found; running unqueued" >&2
fi

exec "${LEFTHOOK_CMD[@]}" "$@"
